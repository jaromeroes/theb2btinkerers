---
import BlogArticle from '../../components/pages/BlogArticle.astro';
import { getCollection } from 'astro:content';
import { isPublished, postSlug } from '../../content/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => post.data.lang === 'en' && isPublished(post))
    .map(post => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---
<BlogArticle lang="en" post={post} />
